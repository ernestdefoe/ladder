includes:
    - vendor/flarum/phpstan/extension.neon

parameters:
    # One process: flarum/phpstan's bootstrap installs a test forum the first
    # time it runs, and parallel workers each start that install at once on a
    # fresh checkout (CI), failing with Install\StepFailed.
    parallel:
        maximumNumberOfProcesses: 1
    level: 6
    paths:
        - extend.php
        - src
    databaseMigrationsPath: [migrations]
    ignoreErrors:
        # The optional extensions' events, wired in Extend\Conditional blocks
        # that only run while that extension is enabled. Naming a class with
        # ::class never loads it.
        -
            identifier: class.notFound
            path: extend.php
